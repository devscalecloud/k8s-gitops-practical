# Copy this file to terraform.tfvars and adjust as needed.
# All values shown are the same as the defaults in variables.tf --
# this file exists mainly so you have a concrete place to override them.

aws_region   = "us-east-2"
project_name = "k8s-gitops"

vpc_cidr             = "10.43.0.0/16"
az_count             = 2
public_subnet_cidrs  = ["10.43.0.0/24", "10.43.1.0/24"]
private_subnet_cidrs = ["10.43.10.0/24", "10.43.11.0/24"]
single_nat_gateway   = true

kubernetes_version = "1.34"
node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 3
